# Build context is the repository root: the API needs `backend/` and, at run
# time, the read-only `data/` directory the engine reads its CSVs from.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=api.settings.prod

WORKDIR /app

COPY backend/pyproject.toml backend/pyproject.toml
COPY backend/risk_engine backend/risk_engine
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -e "backend[api,prod]"

COPY backend backend

WORKDIR /app/backend
EXPOSE 8000
CMD ["gunicorn", "api.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]

# Backend environment. Copy to backend/.env and adjust; never commit the copy.

# Which settings module Django loads: api.settings.dev | api.settings.prod
DJANGO_SETTINGS_MODULE=api.settings.dev

# --- Required by api.settings.prod (dev ships safe defaults for all of these) ---
# Secret key: generate one, e.g.
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-a-generated-secret

# 0 in production. Anything but 1/true/yes/on is false.
DEBUG=0

# Comma-separated, no scheme.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated, scheme included — origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
